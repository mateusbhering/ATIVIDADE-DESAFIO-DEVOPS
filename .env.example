# Copie para .env e ajuste:  cp .env.example .env
# O arquivo .env NAO deve ir para o Git (esta no .gitignore).

# Ambiente exibido em /api/info (local, staging, production)
APP_ENV=local
# Porta exposta no seu computador
APP_PORT=8080
# Cria 6 ocorrencias de demonstracao (ZEL-DEMO0001..6) quando o banco esta vazio
APP_SEED=true
# Schema do Postgres usado pela aplicacao
DB_SCHEMA=public

# Banco PostgreSQL (container "db")
POSTGRES_DB=cidades_esg
POSTGRES_USER=esg
POSTGRES_PASSWORD=troque-esta-senha
